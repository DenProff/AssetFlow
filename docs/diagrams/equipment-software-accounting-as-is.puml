@startuml
!theme plain
title Модель бизнес-процесса учета оборудования и программного обеспечения AS IS

skinparam backgroundColor #FFFFFF
skinparam activity {
  BackgroundColor #FFFFFF
  BorderColor #334155
  FontColor #0F172A
  DiamondBackgroundColor #F8FAFC
  DiamondBorderColor #334155
  StartColor #16A34A
  EndColor #DC2626
}
skinparam note {
  BackgroundColor #FEF2F2
  BorderColor #EF4444
  FontColor #7F1D1D
}

start

partition "Бухгалтерия или ответственное лицо" {
  :Передать сведения о поступлении
  оборудования или ПО;
}

partition "IT-специалист" {
  #FEF2F2:Вручную зафиксировать сведения
  в таблице или журнале;
  note right
  Проблема: нет единого источника данных,
  возможны ошибки и дублирование записей
  end note
}

if (Требуется выдать оборудование
или установить ПО?) then (да)
  partition "Сотрудник" {
    :Обратиться в IT-отдел;
  }

  partition "IT-специалист" {
    #FEF2F2:Вручную проверить наличие
    оборудования или лицензии;
    note right
    Проблема: поиск зависит от актуальности
    таблиц и внутренних журналов
    end note
  }

  if (Оборудование или ПО доступно?) then (да)
    partition "IT-специалист" {
      :Выдать оборудование
      или установить ПО;
      #FEF2F2:Вручную обновить учетные данные;
      note right
      Проблема: статус и история операций
      обновляются не централизованно
      end note

      #FEF2F2:Вручную оформить акт
      или внутренний документ;
      note right
      Проблема: повышается время оформления
      и риск ошибок в реквизитах
      end note
    }
  else (нет)
    partition "IT-специалист" {
      :Сообщить сотруднику
      о невозможности выполнения;
    }
  endif
else (нет)
endif

partition "IT-менеджер" {
  :Запросить сведения для контроля
  или отчетности;
}

partition "IT-специалист" {
  #FEF2F2:Вручную собрать данные
  из таблиц и документов;
  note right
  Проблема: отчетность формируется долго,
  данные могут быть неполными или устаревшими
  end note
}

partition "IT-менеджер" {
  :Проанализировать полученные сведения;
}

partition "Бухгалтерия или ответственное лицо" {
  :Получить отчетные сведения
  или документы;
}

stop
@enduml
