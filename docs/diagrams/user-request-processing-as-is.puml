@startuml
!theme plain
title Модель бизнес-процесса обработки заявки пользователя AS IS

skinparam backgroundColor #FFFFFF
skinparam activity {
  BackgroundColor #FFFFFF
  BorderColor #334155
  FontColor #0F172A
  DiamondBackgroundColor #F8FAFC
  DiamondBorderColor #334155
  StartColor #16A34A
  EndColor #DC2626
}
skinparam note {
  BackgroundColor #FEF2F2
  BorderColor #EF4444
  FontColor #7F1D1D
}

start

partition "Сотрудник" {
  :Обнаружить неисправность оборудования
  или потребность в ПО;
  #FEF2F2:Обратиться в IT-отдел
  по телефону, почте или устно;
  note right
  Проблема: обращение может быть потеряно,
  так как единый реестр заявок отсутствует
  end note
}

partition "IT-специалист" {
  #FEF2F2:Вручную зафиксировать обращение
  или принять его без регистрации;
  note right
  Проблема: нет единого жизненного цикла заявки
  и прозрачной истории обработки
  end note

  #FEF2F2:Уточнить сведения об оборудовании,
  ПО и характере проблемы;
  note right
  Проблема: данные приходится искать
  в разных источниках или уточнять повторно
  end note

  :Проверить возможность выполнения
  ремонта, установки или обновления ПО;
}

if (Требуется согласование?) then (да)
  partition "IT-менеджер" {
    :Рассмотреть обращение;
  }
  if (Согласовано?) then (да)
    partition "IT-специалист" {
      :Приступить к выполнению;
    }
  else (нет)
    partition "IT-специалист" {
      :Подготовить отказ
      или отложить выполнение;
    }
  endif
else (нет)
  partition "IT-специалист" {
    :Приступить к выполнению;
  }
endif

if (Обращение может быть выполнено?) then (да)
  partition "IT-специалист" {
    :Выполнить ремонт,
    установку или обновление ПО;
  }
else (нет)
  partition "IT-специалист" {
    :Сформировать причину отказа
    или переноса выполнения;
  }
endif

partition "IT-специалист" {
  #FEF2F2:Вручную отследить и изменить
  текущий статус обращения;
  note right
  Проблема: сотрудник не видит актуальный статус,
  а контроль выполнения зависит от исполнителя
  end note
}

partition "Сотрудник" {
  #FEF2F2:Получить результат обращения
  по почте, телефону или устно;
  note right
  Проблема: уведомление выполняется вручную
  и требует дополнительной коммуникации
  end note
}

partition "IT-специалист" {
  #FEF2F2:Вручную зафиксировать результат
  обработки обращения;
  note right
  Проблема: итоги работ не всегда связаны
  с оборудованием, ПО и историей операций
  end note
}

stop
@enduml
